<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <property name="CARPETA_LOGS" value="${fixit.logs:-logs}"/>

    <appender name="CONSOLA" class="ch.qos.logback.core.ConsoleAppender">
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>INFO</level>
        </filter>
        <encoder>
            <pattern>%d{HH:mm:ss} %-5level %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="FICHERO" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${CARPETA_LOGS}/fixit.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${CARPETA_LOGS}/fixit.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>14</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] [%X{ejecucion:-sin-id}] %logger{36} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- Todo desde DEBUG -->
    <logger name="com.fixitcampus" level="DEBUG"/>

    <!-- Solo avisos y errores -->
    <root level="WARN">
        <appender-ref ref="CONSOLA"/>
        <appender-ref ref="FICHERO"/>
    </root>

</configuration>
